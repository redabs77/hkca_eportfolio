# Keep all real data entirely outside this repository.
*.sql
*.sql.gz
*.dump
*.bak
data/
dumps/
legacy-data/
*.csv
*.xlsx

# ---- secrets ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# ---- dependencies ----
node_modules/
.pnp
.pnp.js
vendor/
__pycache__/
*.py[cod]
.venv/
venv/
env/

# ---- build output ----
.next/
out/
dist/
build/
*.tsbuildinfo

# ---- test / coverage ----
coverage/
