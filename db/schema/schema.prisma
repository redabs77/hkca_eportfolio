model RetrospectiveRecognition {
  id                                String                          @id @default(uuid())
  traineeId                         String
  applicationDate                   DateTime                        @default(now()) @db.Date // set when access is requested
  applicationType                   String // overseas_training | lateral_transfer | prior_experience
  accessRequestedAt                 DateTime?
  formUnlockedAt                    DateTime?
  formUnlockedById                  String?
  requestedClinicalMonths           Decimal?                        @db.Decimal(4, 2)
  requestedIcuMonths                Decimal?                        @db.Decimal(4, 2)
  requestedElectiveMonths           Decimal?                        @db.Decimal(4, 2)
  requestedCases                    Int?
  decisionDate                      DateTime?                       @db.Date // the date the Training Officer or the Board decided
  decidedByBody                     DecisionBody?
  // Origin is structured, never free text. The ledger reason is DERIVED from it.
  originKind                        String? // OVERSEAS_TRAINING | OTHER_SPECIALTY
  originSpecialty                   String? // for OTHER_SPECIALTY, for example surgery or emergency medicine
  originPlace                       String? // country for overseas training, hospital or place for another specialty
  events                            RetrospectiveRecognitionEvent[] @relation("RecognitionEventRecognition")
  vettingStatus                     RecognitionStatus               @default(ACCESS_REQUESTED)
  assignedReviewerId                String?
  boeReviewDate                     DateTime?                       @db.Date
  approvalDate                      DateTime?                       @db.Date
  creditedBatMonths                 Decimal                         @default(0) @db.Decimal(4, 2)
  creditedHatMonths                 Decimal                         @default(0) @db.Decimal(4, 2)
  creditedIcuMonths                 Decimal                         @default(0) @db.Decimal(4, 2)
  creditedElectiveMonths            Decimal                         @default(0) @db.Decimal(4, 2)
  creditedAccreditedMonths          Decimal                         @default(0) @db.Decimal(4, 2)
  creditedClinicalAnaesthesiaMonths Decimal                         @default(0) @db.Decimal(4, 2)
  creditedCardiacMonths             Decimal                         @default(0) @db.Decimal(4, 2)
  creditedPaediatricMonths          Decimal                         @default(0) @db.Decimal(4, 2)
  creditedObstetricMonths           Decimal                         @default(0) @db.Decimal(4, 2)
  creditedPainMonths                Decimal                         @default(0) @db.Decimal(4, 2)
  overseasInstitution               String?
  overseasProgramName               String?
  overseasTrainingStart             DateTime?                       @db.Date
  overseasTrainingEnd               DateTime?                       @db.Date
  overseasDurationMonths            Decimal?                        @db.Decimal(4, 2)
  vettingNotes                      String?
  boeDecisionRationale              String?
  conditionsAttached                String?
  documentsJson                     Json? // [{type, filePath, uploadedDate}]
  createdById                       String?
  approvedById                      String?
  createdAt                         DateTime                        @default(now())
  updatedAt                         DateTime                        @default(now()) @updatedAt

  trainee           TraineeProfile        @relation("RecognitionTrainee", fields: [traineeId], references: [id], onDelete: Restrict)
  formUnlockedBy    User?                 @relation("RecognitionUnlocker", fields: [formUnlockedById], references: [id], onDelete: Restrict)
  assignedReviewer  User?                 @relation("RecognitionReviewer", fields: [assignedReviewerId], references: [id], onDelete: Restrict)
  createdBy         User?                 @relation("RecognitionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy        User?                 @relation("RecognitionApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  creditAdjustments VopCreditAdjustment[] @relation("CreditRecognition")

  @@index([traineeId])
  @@index([vettingStatus])
}

model VopCreditAdjustment {
