// Mandatory Courses (EASE, EMAC, ADAM-A, ECHO-A, USRA-E)
model MandatoryCourse {
  id             String             @id @default(uuid())
  traineeId      String
  courseCode     String
  courseName     String
  completionDate DateTime           @db.Date
  status         VerificationStatus @default(PENDING)
  documentId     String?

  verifiedById String?
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

