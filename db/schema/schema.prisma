model ExamApplication {
  id        String   @id @default(uuid())
  traineeId String
  examType  String // "INTERMEDIATE", "FINAL_ANAESTHESIA", "FINAL_ICU"
  examDate  DateTime

  submittedAt       DateTime           @default(now())
  sotApprovalStatus VerificationStatus @default(PENDING)
  sotApprovedAt     DateTime?
  sotApprovedById   String?

  collegeVettingStatus String  @default("UNDER_REVIEW")
  result               String? // "PASS", "FAIL"

  trainee       TraineeProfile      @relation(fields: [traineeId], references: [id], onDelete: Restrict)
  // --- Admin console / schema doc alignment (2026-10-24) ---
  attemptNumber Int                 @default(1)
  score         Decimal?            @db.Decimal(5, 2)
  sourceBatchId String?
  // --- Admin console / schema doc alignment (2026-10-24) ---
  sourceBatch   BulkIngestionBatch? @relation("ExamBatch", fields: [sourceBatchId], references: [id], onDelete: SetNull)

  // --- Secretariat console (2026-10-25, migration 5) ---
  // result, score, attemptNumber and sourceBatchId below are superseded by ExamResult; kept until no code reads them.
  sittingId            String?
  withdrawnAt          DateTime?
  withdrawnKind        String? // trainee | admin
  sotDeclineReason     String? // set when sotApprovalStatus = REJECTED
  feeReceivedAt        DateTime?    @db.Date
  feeMethod            String? // Faster Payment System | Bank deposit | E-cheque
  feeReference         String?
  slipDocumentId       String? // payment slip, attached by the trainee or emailed and attached by Admin
  boardExceptionReason String? // Board exception when criteria are not met (reason and reference)
  boardExceptionAt     DateTime?    @db.Date
  notAdmittedAt        DateTime?
  sectionsToSit        String[]     @default([]) // snapshot at application: PHYSIOLOGY / PHARMACOLOGY, or WRITTEN / ORAL / OSCE
  sitting              ExamSitting? @relation("ApplicationSitting", fields: [sittingId], references: [id], onDelete: Restrict)
  results              ExamResult[] @relation("ResultApplication")

  @@unique([traineeId, sittingId])
  @@index([sittingId])
  @@index([traineeId, examType, examDate])
}

model FormalProject {
  id          String        @id @default(uuid())
  traineeId   String
  projectType String // "RCT", "META_ANALYSIS", "OBSERVATIONAL", "QIP", "CASE_REPORT"
  title       String
  status      ProjectStatus @default(PROTOCOL_DRAFT)

  protocolSubmittedDate DateTime?
  protocolPath          String?
  manuscriptPath        String?

  // Blinded Reviewers. CURRENT reviewers only; FormalProjectReview is the source of truth. Review period is two months (HKCA-E03)
  reviewer1Id     String?
  reviewer2Id     String?
  reviewer1Status String? // "APPROVED", "REVISION", "REJECT"
  reviewer2Status String?
  reviewDueDate   DateTime?

  finalApprovalDate DateTime?
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  trainee            TraineeProfile        @relation(fields: [traineeId], references: [id], onDelete: Restrict)
  reviewer1          User?                 @relation("ProjectReviewer1", fields: [reviewer1Id], references: [id], onDelete: Restrict)
  reviewer2          User?                 @relation("ProjectReviewer2", fields: [reviewer2Id], references: [id], onDelete: Restrict)
  // --- Admin console / schema doc alignment (2026-10-24) ---
  projectNumber      String?               @unique // College project number, e.g. FP-26-014
  // --- Admin console / schema doc alignment (2026-10-24) ---
  events             FormalProjectEvent[]  @relation("ProjectEventProject")
  reviews            FormalProjectReview[] @relation("ReviewProject")
  stages             FormalProjectStage[]  @relation("StageProject")
  // Route: STANDARD (protocol then manuscript) or ACCEPTED_PAPER (guideline 2.1: accepted peer-reviewed paper, trainee first or corresponding author; no protocol)
  route              String                @default("STANDARD")
  paperJournal       String?
  paperAuthorship    String?
  paperAcceptedOn    DateTime?             @db.Date
  paperEvidenceDocId String?

  @@index([traineeId, status])
}

model PfyPlan {
  id           String @id @default(uuid())
  traineeId    String
  academicYear String // "2026-2027"

  clinicalPlan   String
  managementPlan String
  educationPlan  String

  sotApprovedById String?
  sotApprovedDate DateTime?
  cosApprovedById String?
  cosApprovedDate DateTime?

  completionReport String?
  completionDate   DateTime?
  status           VerificationStatus @default(PENDING)

  trainee     TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Restrict)
  sotApprover User?          @relation("PfySotSigner", fields: [sotApprovedById], references: [id], onDelete: Restrict)
  cosApprover User?          @relation("PfyCosSigner", fields: [cosApprovedById], references: [id], onDelete: Restrict)

  @@index([traineeId, academicYear])
}

// =============================================================================
// 10. TAMPER-EVIDENT APPEND-ONLY AUDIT LOG (H7)
// =============================================================================

model AuditLog {
  id         BigInt @id @default(autoincrement())
  entityType String // "TRAINEE", "LEDGER", "ROTATION", "ITA", "VOP"
  entityId   String
  action     String // "CREATE", "UPDATE", "REVOKE", "SIGN", "CONTEST"

  beforeJson Json?
  afterJson  Json?

  performedById String
  performedAt   DateTime @default(now())
  ipAddress     String?
  userAgent     String?

  // Cryptographic Hash Chaining (H7)
  prevHash String?
  rowHash  String // SHA-256 (prevHash + canonical row payload)

  performedByUser User @relation("AuditActor", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([performedById, performedAt])
  @@index([performedAt])
}

