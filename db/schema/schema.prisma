  endorsementDocId       String?
  status                 ApplicationStatus        @default(SUBMITTED)
  returnNote             String?
  decidedById            String?
  decidedAt              DateTime?
  traineeId              String?                  @unique // set on approval
  mchkRegistrationType   String? // full | limited. Not a specialist registration: applicants are not yet specialists
  mchkRegistrationNumber String?
  endorsements           ApplicationEndorsement[] @relation("EndorsementApplication")

