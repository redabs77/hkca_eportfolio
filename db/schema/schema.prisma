  parentHospital Hospital?       @relation("ApplicationHospital", fields: [parentHospitalId], references: [id], onDelete: Restrict)
  decidedBy      User?           @relation("ApplicationDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  trainee        TraineeProfile? @relation("ApplicationTrainee", fields: [traineeId], references: [id], onDelete: Restrict)

