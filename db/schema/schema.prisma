// =============================================================================
// HKCA Electronic Portfolio System (EPS / ETP NextGen)
// Master Prisma Database Schema — PostgreSQL Engine
// Version: 1.0.0
// Date: 2026-10-01
// Governing Document: HKCA ePortfolio Master PRD
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// 1. ENUMS & TAXONOMIES
// =============================================================================

enum UserRole {
  TRAINEE
  TRAINER
  SOT
  ASSISTANT_SOT
  CLUSTER_SOT
  CHIEF_OF_SERVICE
  COLLEGE_ADMIN
  BOE_MEMBER
  EXTERNAL_ASSESSOR
}

enum TrainingStage {
  BAT // Basic Anaesthesia Training (24 months)
  HAT // Higher Anaesthesia Training (24 months)
  PFY // Provisional Fellowship Year (12 months)
  FELLOW
  SUSPENDED
  TERMINATED
}

enum RotationType {
  CLINICAL_ANAESTHESIA
  ICU
  PAIN_MEDICINE
  ELECTIVE_OTHER
  ELECTIVE_RESEARCH
  OVERSEAS_APPROVED
}

enum LedgerDecision {
  GRANT
  REVOKE
  AMEND
}

enum LedgerReason {
  SATISFACTORY_ITA_COMPLETION
  CONFLICT_OF_INTEREST
  NON_ACCREDITED_SITE
  UNAUTHORIZED_SIGNATORY
  SUCCESSFUL_APPEAL_OVERTURN
  ADMINISTRATIVE_ERROR
  FRAUDULENT_RECORD
  INCORRECT_CATEGORY
  PARTIAL_CREDIT_CORRECTION
  CONDITIONAL_REQUIREMENT_FULFILLED
  CURRICULUM_RULE_CHANGE
  SUPERSEDES_DUPLICATE
  OTHER_BOE_DIRECTED
}

enum ItaStatus {
  PENDING_TRAINER_FEEDBACK
  SOT_SYNTHESIS
  AWAITING_TRAINEE_SIGNATURE
  COMPLETED_SATISFACTORY
  COMPLETED_UNSATISFACTORY
  CONTESTED
  PENDING_BOE_REVIEW
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED_FOR_REVIEW
}

enum WbaModality {
  CEX
  DOPS
  CBD
  ALMAT
  EPA
  MSF
}

// Note: PBA and ACR are NOT part of the HKCA WBA toolset (confirmed with Albert 2026-10-07),
// despite being present in JCIMED's generic modality enum. Do not add them here.

enum ProjectStatus {
  PROTOCOL_DRAFT
  PROTOCOL_SUBMITTED
  UNDER_REVIEW
  REVISION_REQUIRED
  MANUSCRIPT_SUBMITTED
  APPROVED
  REJECTED
}

enum BulkIngestionType {
  MANDATORY_COURSE
  EXAM_RESULT
  ROTATION_ALLOCATION
  CENTRE_APPOINTMENT
  OTHER
}

enum BulkIngestionStatus {
  PENDING_VALIDATION
  VALIDATED
  COMMITTED
  ROLLED_BACK
  FAILED
}

enum ExitDossierStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ACTION_REQUIRED
}

enum DocumentCategory {
  MANDATORY_COURSE_CERT
  FORMAL_PROJECT_MANUSCRIPT
  PFY_EVALUATION
  EXEMPTION_PETITION
  EXIT_SUPPORTING_DOC
  OTHER
}

enum DocumentStatus {
  DRAFT
  PENDING_REVIEW
  VERIFIED
  ACTION_REQUIRED
}

enum EchoStudyType {
  TTE
  TOE
  FOCUS
}

// =============================================================================
// 2. USER DIRECTORY & ROLE-BASED ACCESS CONTROL (RBAC)
// =============================================================================

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  hkcaNumber  String?  @unique // HKCA's own College Trainee Number. Supplementary only — NOT the
  // primary cross-college identifier. JCIMED has agreed to carry this
  // as a supplementary field in iWBA, synced via a mapping table
  // (same mechanism as the curriculum item mapping), per their
  // 2026-10-07 reply. Do not use for identity resolution.
  hkamId      String?  @unique // eHKAM account ID (HKAM single sign-on identity). Per JCIMED's
  // 2026-10-07 clarification: NOT the HKAM Fellow ID. All trainees
  // (including BAT/HAT) are eligible; HKAM rolled out self-registration
  // from 2026-09-30. Null only for trainees who haven't yet signed in
  // via HKAM SSO (using a College-Admin-created local account).
  // Survives college transfers and MCHK registration-status changes
  // (provisional/special/limited) — the most stable cross-college
  // identifier available. eHKAM accounts cannot be shared (GWS security).
  mchkNumber  String?  @unique
  iwbaUserId  String?  @unique // Permanent HKAM iWBA user ID (JCIMED-confirmed 2026-10-06).
  // Every iWBA account (eHKAM-linked or local) has one, so it's the
  // single stable identifier even before a trainee completes eHKAM SSO.
  // Resolution priority: iwbaUserId -> hkamId (eHKAM SSO ID) -> email -> SOT manual verification.
  primaryRole UserRole @default(TRAINEE)
  isActive    Boolean  @default(true)

  // Auditing & Soft-delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  deletedBy String?

  // Relations
  traineeProfile TraineeProfile?
  trainerProfile TrainerProfile?
  roles          UserRoleAssignment[]
  auditLogs      AuditLog[]           @relation("AuditActor")

  // Signature relations
  rotationsSupervised   Rotation[]             @relation("SotSupervisor")
  itaSessionsAuthored   ItaSession[]           @relation("SotAuthor")
  itaAssessorResponses  ItaAssessorResponse[]  @relation("TrainerAssessor")
  vopVerified           VolumeOfPractice[]     @relation("VopVerifier")
  remedialPlansMentored RemedialPlan[]         @relation("MentorUser")
  formalProjectsRev1    FormalProject[]        @relation("ProjectReviewer1")
  formalProjectsRev2    FormalProject[]        @relation("ProjectReviewer2")
  pfySotSignatures      PfyPlan[]              @relation("PfySotSigner")
  pfyCosSignatures      PfyPlan[]              @relation("PfyCosSigner")
  ledgerActions         AccreditedTimeLedger[] @relation("LedgerAuthority")

  // Stakeholder Survey Extensions (S1-S4)
  bulkBatchesExecuted   BulkIngestionBatch[]    @relation("BulkBatchExecutor")
  exitDossiersReviewed  FellowshipExitDossier[] @relation("ExitDossierReviewer")
  documentsVerified     DocumentRecord[]        @relation("DocumentVerifier")
  coursesVerified       MandatoryCourse[]       @relation("CourseVerifier")
  echoStudiesSupervised EchoStudy[]             @relation("EchoSupervisor")

  @@index([email, hkcaNumber])
  @@index([hkamId])
  @@index([isActive])
}

model UserRoleAssignment {
  id             String    @id @default(uuid())
  userId         String
  role           UserRole
  scopeType      String // "COLLEGE", "CLUSTER", "HOSPITAL", "DEPARTMENT"
  scopeId        String? // e.g., hospitalId or clusterId
  effectiveFrom  DateTime  @default(now())
  effectiveUntil DateTime?
  isActive       Boolean   @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, role, isActive])
  @@index([scopeType, scopeId])
}

model TraineeProfile {
  id                  String        @id @default(uuid())
  userId              String        @unique
  hkcaNumber          String        @unique
  currentStage        TrainingStage @default(BAT)
  curriculumEditionId String

  // Administrative Home
  parentHospitalId String
  commencementBat  DateTime?
  completionBat    DateTime?
  commencementHat  DateTime?
  completionHat    DateTime?
  commencementPfy  DateTime?
  completionPfy    DateTime?

  // Milestone Eligibility Flags (Evaluated via live base table queries)
  intermediateExamPassed    Boolean   @default(false)
  intermediateExamDate      DateTime?
  finalExamPassed           Boolean   @default(false)
  finalExamDate             DateTime?
  formalProjectApproved     Boolean   @default(false)
  formalProjectApprovalDate DateTime?

  // Status flags
  isSuspended           Boolean @default(false)
  lifetimeUnsatItaCount Int     @default(0) // Trigger for H8 SOT review flag
  version               Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Relations
  user              User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  parentHospital    Hospital               @relation(fields: [parentHospitalId], references: [id], onDelete: Restrict)
  curriculumEdition CurriculumEdition      @relation(fields: [curriculumEditionId], references: [id], onDelete: Restrict)
  rotations         Rotation[]
  itaSessions       ItaSession[]
  ledgerEntries     AccreditedTimeLedger[]
  volumeOfPractice  VolumeOfPractice[]
  wbaAssessments    WbaAssessment[]
  remedialPlans     RemedialPlan[]
  examApplications  ExamApplication[]
  formalProjects    FormalProject[]
  pfyPlans          PfyPlan[]

  // Stakeholder Survey Extensions (S1-S4)
  mandatoryCourses MandatoryCourse[]
  documents        DocumentRecord[]
  echoStudies      EchoStudy[]
  exitDossiers     FellowshipExitDossier[]

  @@index([currentStage, isSuspended])
  @@index([parentHospitalId])
}

model TrainerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  hospitalId     String
  isSot          Boolean  @default(false)
  isAssistantSot Boolean  @default(false)
  isClusterSot   Boolean  @default(false)
  qualifications String[] // ["FHKCA", "FANZCA", "FRCA"]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  @@index([hospitalId, isSot])
}

// =============================================================================
// 3. HOSPITALS, CLUSTERS & TEMPORAL ACCREDITATION
// =============================================================================

model Cluster {
  id          String  @id @default(uuid())
  code        String  @unique // "NTEC", "KWC", "HKWC", "KCC", "HKE", "NTWC", "KEC"
  name        String
  description String?

  hospitals HospitalClusterHistory[]
}

model Hospital {
  id           String  @id @default(uuid())
  hospitalCode String  @unique // "PWH", "QMH", "QEH", "KWH", "TMH", "UCH", "PMH"
  hospitalName String
  isHaHospital Boolean @default(true)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  clusterHistory    HospitalClusterHistory[]
  accreditedCentres AccreditedCentre[]
  traineeProfiles   TraineeProfile[]
  trainerProfiles   TrainerProfile[]
  rotations         Rotation[]
  vopEntries        VolumeOfPractice[]

  @@index([hospitalCode])
}

model HospitalClusterHistory {
  id             String    @id @default(uuid())
  hospitalId     String
  clusterId      String
  effectiveFrom  DateTime  @default(now())
  effectiveUntil DateTime? // NULL indicates current active cluster affiliation

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  cluster  Cluster  @relation(fields: [clusterId], references: [id], onDelete: Restrict)

  @@index([hospitalId, effectiveUntil])
  @@index([clusterId])
}

model AccreditedCentre {
  id                     String   @id @default(uuid())
  hospitalId             String
  centreName             String // e.g., "PWH Anaesthesia", "QMH ICU"
  accreditationTypes     String[] // ["CLINICAL_ANAESTHESIA", "ICU", "PAIN_MEDICINE"]
  accreditationStatus    String   @default("ACTIVE") // "ACTIVE", "PENDING_REVIEW", "SUSPENDED", "EXPIRED"
  accreditationStartDate DateTime
  accreditationEndDate   DateTime
  maxDurationMonths      Int? // Maximum accredited months per rotation
  maxTraineeCapacity     Int?
  trainerTraineeRatio    String? // e.g. "1:1.2"
  isSatelliteCentre      Boolean  @default(false)
  parentCentreId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  hospital  Hospital                @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  rotations Rotation[]
  auditLogs AccreditationAuditLog[]

  @@index([hospitalId, accreditationStatus])
  @@index([accreditationEndDate])
}

model AccreditationAuditLog {
  id           String   @id @default(uuid())
  centreId     String
  action       String // "RENEWED", "AMENDED", "SUSPENDED"
  fieldChanged String?
  oldValue     String?
  newValue     String?
  changedBy    String
  changedAt    DateTime @default(now())
  notes        String?

  centre AccreditedCentre @relation(fields: [centreId], references: [id], onDelete: Restrict)

  @@index([centreId, changedAt])
}

// =============================================================================
// 4. DYNAMIC CURRICULUM & SCHEMA-DRIVEN FORMS ENGINE
// =============================================================================

model CurriculumEdition {
  id             String    @id @default(uuid())
  code           String    @unique // "HKCA-CURR-2017-v1.1", "HKCA-CURR-2028-v1.0"
  name           String
  effectiveFrom  DateTime
  effectiveUntil DateTime? // NULL indicates currently active for new intakes
  description    String?

  traineeProfiles TraineeProfile[]
  milestones      CurriculumMilestone[]
  rules           CurriculumRule[]

  @@index([code, effectiveFrom])
}

model CurriculumRule {
  id                  String    @id @default(uuid())
  editionId           String
  ruleCode            String // e.g., "BAT_MIN_VOP", "HAT_LAST_3YR_ACCREDITED"
  ruleCategory        String // "VOP", "WBA", "ROTATION", "EXAM", "TIME"
  thresholdValue      Decimal   @db.Decimal(10, 2)
  effectiveFrom       DateTime  @default(now())
  effectiveUntil      DateTime?
  curriculumReference String? // "Vocational Training Guide §1.2.4"

  edition CurriculumEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)

  @@index([editionId, ruleCode])
}

model CurriculumDescriptor {
  id              String  @id @default(uuid())
  code            String  @unique // e.g., "2.1", "2.2", "3.4", "3.5"
  name            String // e.g., "Regional Anaesthesia", "Paediatric Anaesthesia"
  category        String // "CLINICAL_FUNDAMENTALS" or "SPECIALTY_MODULES"
  subspecialtyTag String? // "paediatric", "obstetric", "cardiac", "neuro", "icu"
  description     String?

  vopCases       VolumeOfPractice[]
  wbaAssessments WbaAssessment[]

  @@index([code, category])
}

model CurriculumMilestone {
  id               String        @id @default(uuid())
  editionId        String
  stage            TrainingStage
  milestoneCode    String // "BAT_TO_HAT_PROGRESSION", "FINAL_EXAM_ELIGIBILITY"
  requirementsJson Json // Structured requirement schema (VOP, WBA counts, courses)

  edition CurriculumEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)

  @@index([editionId, stage, milestoneCode])
}

model AssessmentTool {
  id             String      @id @default(uuid())
  code           String      @unique // "HKCA-E06-ITA", "MINI-CEX", "DOPS", "EPA-01"
  name           String
  modality       WbaModality
  version        Int         @default(1)
  rubricSchema   Json // Question schema, Likert scales, and behavioral anchors
  effectiveFrom  DateTime    @default(now())
  effectiveUntil DateTime?

  itaAssessorResponses ItaAssessorResponse[]

  @@index([code, modality])
}

// =============================================================================
// 5. ROTATIONS & THE ACCREDITED TIME LEDGER (M2 & M3)
// =============================================================================

model Rotation {
  id                 String       @id @default(uuid())
  traineeId          String
  hospitalId         String
  accreditedCentreId String
  rotationType       RotationType
  subspecialty       String? // "CARDIAC", "PAEDIATRICS", "ICU", etc.

  startDate      DateTime
  endDate        DateTime
  durationMonths Decimal  @db.Decimal(5, 2) // Derived calendar month duration

  // Gating & Verification
  sotId          String
  approvalStatus VerificationStatus @default(PENDING)
  approvedAt     DateTime?
  learningGoals  String?

  isAccredited Boolean @default(true)
  version      Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  trainee          TraineeProfile         @relation(fields: [traineeId], references: [id], onDelete: Restrict)
  hospital         Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  accreditedCentre AccreditedCentre       @relation(fields: [accreditedCentreId], references: [id], onDelete: Restrict)
  sotSupervisor    User                   @relation("SotSupervisor", fields: [sotId], references: [id], onDelete: Restrict)
  itaSessions      ItaSession[]
  ledgerEntries    AccreditedTimeLedger[]

  @@index([traineeId, startDate, endDate])
  @@index([hospitalId, rotationType])
}

model AccreditedTimeLedger {
  id           String  @id @default(uuid())
  traineeId    String
  rotationId   String?
  itaSessionId String?

  periodStart            DateTime
  periodEnd              DateTime
  calendarMonthsCredited Decimal      @db.Decimal(5, 2) // Exact calendar month calculation
  category               RotationType
  countsTowardLast3Years Boolean      @default(true)

  // Decision & Audit Trail (BOE Exclusive Authority for Revoke/Amend)
  decision       LedgerDecision @default(GRANT)
  decisionReason LedgerReason
  decisionNotes  String?
  authorityId    String // User who authorized action (BOE member / SOT)
  authorityRole  UserRole

  conditionsJson Json? // Conditional requirements attached to credit
  supersedesId   String? // Reference to previous ledger row if amended/revoked
  effectiveAt    DateTime @default(now())
  isCurrent      Boolean  @default(true)

  trainee       TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Restrict)
  rotation      Rotation?      @relation(fields: [rotationId], references: [id], onDelete: Restrict)
  itaSession    ItaSession?    @relation(fields: [itaSessionId], references: [id], onDelete: Restrict)
  authorityUser User           @relation("LedgerAuthority", fields: [authorityId], references: [id], onDelete: Restrict)

  @@index([traineeId, isCurrent])
  @@index([rotationId])
}

// =============================================================================
// 6. 2-TIER IN-TRAINING ASSESSMENT (ITA) PIPELINE (M1, M6, H1, H3, U1)
// =============================================================================

model ItaSession {
  id         String @id @default(uuid())
  rotationId String
  traineeId  String
  sotId      String

  cycleStart    DateTime
  cycleEnd      DateTime
  trainingStage TrainingStage
  status        ItaStatus     @default(PENDING_TRAINER_FEEDBACK)

  // SOT Summative Evaluation & Appeals Split (M6)
  // sotGrade = the OVERALL assessment: 1=Consistently exceeds, 2=Occasionally exceeds,
  // 3=Usually meets (PASS), 4=Unsatisfactory. Only 4 is unsatisfactory.
  sotGrade        Int?
  finalGrade      Int? // Post-appeal authoritative grade evaluated by gates
  sotComments     String?
  learningSummary String?

  // Official HKCA 15-item ITA form (decision I1). The SOT's consolidated grade for each item
  // is what the trainee signs. Shape: { "<ITEM_CODE>": "1"|"2"|"3"|"4"|"X" } keyed by the 15
  // codes in domain/ita/itaDomains.ts. X (unable to assess) never counts toward the 4-item rule.
  itemGradesJson           Json?
  // Why the SOT's grade differs where trainers' grades spread >= 2 levels. { "<ITEM_CODE>": "reason" }
  divergenceReasonsJson    Json?
  // Count of items graded 4, frozen at SOT signing so the audit trail shows what the College
  // rule saw. Overall is forced to 4 when this is >= 4.
  unsatisfactoryItemCount  Int?
  // Required when overall = 4 while unsatisfactoryItemCount < 4 (discretionary unsatisfactory).
  discretionaryUnsatReason String?
  // SOT-only brackets on the College form. { "EASE": true, "ADAM-A": true, ... }
  coursesAttendedJson      Json?
  formalProjectCompleted   Boolean?
  // Edition of the form's items and anchors this session was rated against.
  formVersion              String   @default("HKCA-ITA-15-v1")

  // Trainee Reflection & In-Person Sign-Off (H1)
  traineeReflection String?
  traineeSignedAt   DateTime?

  // Contested Dispute State Machine
  isContested        Boolean   @default(false)
  contestedStatement String?
  contestedAt        DateTime?
  boeReviewStatus    String? // "UNDER_REVIEW", "UPHELD", "OVERTURNED"

  // Dates & Locking
  sotSignedAt DateTime?
  completedAt DateTime?
  version     Int       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  rotation          Rotation               @relation(fields: [rotationId], references: [id], onDelete: Restrict)
  trainee           TraineeProfile         @relation(fields: [traineeId], references: [id], onDelete: Restrict)
  sotAuthor         User                   @relation("SotAuthor", fields: [sotId], references: [id], onDelete: Restrict)
  assessorResponses ItaAssessorResponse[]
  ledgerEntries     AccreditedTimeLedger[]
  remedialPlan      RemedialPlan?
  appeals           ItaAppeal[]

  @@index([traineeId, status])
  @@index([rotationId])
}

model ItaAssessorResponse {
  id           String @id @default(uuid())
  itaSessionId String
  trainerId    String
  toolId       String

  // Official 15-item form (decision I1; supersedes the U1 two-prompt design). No auto-prefill.
  // Shape: { "<ITEM_CODE>": { "grade": "1"|"2"|"3"|"4"|"X", "example": "..." } } for all 15
  // codes in domain/ita/itaDomains.ts. An example is required for grade 4 only; 1-3 and X are optional.
  domainRatingsJson  Json
  // "Comments from Specialist Assessors" - optional, one box for the whole form.
  specialistComments String?
  // SHA-256 of the canonical submitted record, computed at submit. A sealed response is never
  // edited; a later correction is a separate annotation in the audit log (H7).
  recordHash         String?
  formVersion        String  @default("HKCA-ITA-15-v1")

  submittedAt DateTime @default(now())

  itaSession ItaSession     @relation(fields: [itaSessionId], references: [id], onDelete: Restrict)
  trainer    User           @relation("TrainerAssessor", fields: [trainerId], references: [id], onDelete: Restrict)
  tool       AssessmentTool @relation(fields: [toolId], references: [id], onDelete: Restrict)

  // One sealed response per trainer per ITA session.
  @@unique([itaSessionId, trainerId])
}

model ItaAppeal {
  id           String @id @default(uuid())
  itaSessionId String
  traineeId    String

  appealDate         DateTime @default(now())
  groundsForAppeal   String
  supportingDocsJson Json?

  boeDecision     String? // "UPHELD", "OVERTURNED_SATISFACTORY", "RE_ASSESSMENT"
  overturnedGrade Int?
  boeDecisionDate DateTime?
  boeMinutesRef   String?

  itaSession ItaSession @relation(fields: [itaSessionId], references: [id], onDelete: Restrict)

  @@index([itaSessionId])
}

model RemedialPlan {
  id               String  @id @default(uuid())
  itaSessionId     String  @unique
  traineeId        String
  assignedMentorId String?

  triggerReason          String
  actionItemsJson        Json // Array of required targets, clinics, simulation sessions
  targetReassessmentDate DateTime
  actualReassessmentDate DateTime?
  status                 String    @default("ACTIVE") // "ACTIVE", "RESOLVED_SATISFACTORY", "ESCALATED_BOE"

  resolvedAt DateTime?

  itaSession ItaSession     @relation(fields: [itaSessionId], references: [id], onDelete: Restrict)
  trainee    TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Restrict)
  mentor     User?          @relation("MentorUser", fields: [assignedMentorId], references: [id], onDelete: Restrict)

  @@index([traineeId, status])
}

// =============================================================================
// 7. VOLUME OF PRACTICE (E-LOGBOOK) (H5, U2, U3, U4)
// =============================================================================

model VolumeOfPractice {
  id         String @id @default(uuid())
  traineeId  String
  hospitalId String

  caseDate       DateTime  @db.Date
  firstLoggedAt  DateTime  @default(now()) // Immutable database insert timestamp (H5)
  deviceLoggedAt DateTime? // Client-side capture timestamp for offline PWA sync (U2)

  durationHours   Decimal? @db.Decimal(4, 2)
  asaClass        Int?
  patientAgeYears Int?
  isEmergency     Boolean  @default(false)

  // Clinical Details
  surgicalDiagnosis    String?
  primaryOperation     String?
  anaestheticTechnique String[] // ["GA", "SPINAL", "EPIDURAL", "TIVA", "UGRA"]
  supervisionLevel     Int // 1=Direct, 2=Indirect, 3=Autonomous

  // Dynamic Curriculum Classification (Descriptor FK)
  descriptorCode           String
  vopCategory              String // "CLINICAL_FUNDAMENTALS" or "SPECIALTY_MODULES"
  classifiedBy             String // "TRAINEE", "CLASSIFIER", "SOT_OVERRIDE"
  classificationConfidence Decimal? @db.Decimal(4, 3)
  classifierDiverged       Boolean  @default(false)

  // Retrospective 2-Year Lock & Accreditation Flags
  isAccredited           Boolean @default(true)
  disqualificationReason String? // "EXCEEDED_2YR_WINDOW", "NON_ACCREDITED_ROTATION"

  // Verification State (U3: SOT Guardrails)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedById       String?
  verifiedAt         DateTime?
  verificationNotes  String?
  version            Int                @default(1)

  // Legacy Provenance Tracking
  legacyPid Int?
  legacyTid String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  trainee        TraineeProfile       @relation(fields: [traineeId], references: [id], onDelete: Restrict)
  hospital       Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  descriptor     CurriculumDescriptor @relation(fields: [descriptorCode], references: [code], onDelete: Restrict)
  verifiedByUser User?                @relation("VopVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  caseBlocks     CaseBlock[]

  @@index([traineeId, caseDate])
  @@index([firstLoggedAt, isAccredited])
  @@index([descriptorCode])
  @@index([verificationStatus])
}

model CaseBlock {
  id             String @id @default(uuid())
  vopId          String
  blockSite      String // "FEMORAL", "AXILLARY", "INTERSCALENE"
  blockTechnique String // "ULTRASOUND", "PNS", "LANDMARK"
  sequence       Int    @default(1)

  vop VolumeOfPractice @relation(fields: [vopId], references: [id], onDelete: Cascade)

  @@index([vopId])
}

// =============================================================================
// 8. WORKPLACE-BASED ASSESSMENTS (WBA) & HKAM iWBA SYNC (E2)
// =============================================================================

model WbaAssessment {
  id             String  @id @default(uuid())
  traineeId      String
  descriptorCode String?

  // HKAM iWBA Integration Contract (E2)
  jcimedWbaId   String      @unique // UUID from https://wba.zlightinno.com
  modality      WbaModality
  datePerformed DateTime    @db.Date

  // Immutable Point-in-Time Assessor Snapshot
  assessorHkamId           String?
  assessorNameSnapshot     String
  assessorHospitalSnapshot String?

  procedureCode      String? // e.g., "DOPS-12", "EPA-01" (JCIMED's internal procedure code)
  procedureName      String?
  iwbaCurriculumCode String? // College code JCIMED maps to this procedure, e.g. "CF-2.3", "SM-3.4"
  // per HKCA Curriculum Competency Mapping Table (for JCIMED).md
  iwbaTrainingStage  String? // Stage tag returned alongside the procedure, e.g. "BT", "HT" (JCIMED's own label — map to TrainingStage enum on ingest)
  entrustmentLevel   Int? // 1-5 for EPA records
  workflowOutcome    String? // "COMPLETE", "FAIL"

  // Full Assessment Timeline & Qualitative Feedback
  timelineAnswersJson Json // Complete step-by-step form answers, Likert ratings

  syncBatchId String?
  syncStatus  String   @default("SYNCED")
  importedAt  DateTime @default(now())

  trainee    TraineeProfile        @relation(fields: [traineeId], references: [id], onDelete: Restrict)
  descriptor CurriculumDescriptor? @relation(fields: [descriptorCode], references: [code], onDelete: Restrict)

  @@index([traineeId, modality, datePerformed])
  @@index([jcimedWbaId])
}

model WbaSyncConflict {
  id             String    @id @default(uuid())
  jcimedWbaId    String    @unique
  errorReason    String // "UNRESOLVED_TRAINEE_IDENTITY", "UNMAPPED_DESCRIPTOR"
  rawPayloadJson Json
  resolved       Boolean   @default(false)
  resolvedAt     DateTime?
  resolvedBy     String?
  createdAt      DateTime  @default(now())

  @@index([resolved, createdAt])
}

// =============================================================================
// 9. EXAMS, COURSES & FORMAL PROJECTS (HKCA-E03, PFY)
// =============================================================================

model ExamApplication {
  id        String   @id @default(uuid())
  traineeId String
  examType  String // "INTERMEDIATE", "FINAL_ANAESTHESIA", "FINAL_ICU"
  examDate  DateTime

  submittedAt       DateTime           @default(now())
  sotApprovalStatus VerificationStatus @default(PENDING)
  sotApprovedAt     DateTime?
  sotApprovedById   String?

  collegeVettingStatus String  @default("UNDER_REVIEW")
  result               String? // "PASS", "FAIL"

  trainee TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Restrict)

  @@index([traineeId, examType, examDate])
}

model FormalProject {
  id          String        @id @default(uuid())
  traineeId   String
  projectType String // "RCT", "META_ANALYSIS", "OBSERVATIONAL", "QIP", "CASE_REPORT"
  title       String
  status      ProjectStatus @default(PROTOCOL_DRAFT)

  protocolSubmittedDate DateTime?
  protocolPath          String?
  manuscriptPath        String?

  // Blinded Reviewers (E6: 30-day tracking clock)
  reviewer1Id     String?
  reviewer2Id     String?
  reviewer1Status String? // "APPROVED", "REVISION", "REJECT"
  reviewer2Status String?
  reviewDueDate   DateTime?

  finalApprovalDate DateTime?
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  trainee   TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Restrict)
  reviewer1 User?          @relation("ProjectReviewer1", fields: [reviewer1Id], references: [id], onDelete: Restrict)
  reviewer2 User?          @relation("ProjectReviewer2", fields: [reviewer2Id], references: [id], onDelete: Restrict)

  @@index([traineeId, status])
}

model PfyPlan {
  id           String @id @default(uuid())
  traineeId    String
  academicYear String // "2026-2027"

  clinicalPlan   String
  managementPlan String
  educationPlan  String

  sotApprovedById String?
  sotApprovedDate DateTime?
  cosApprovedById String?
  cosApprovedDate DateTime?

  completionReport String?
  completionDate   DateTime?
  status           VerificationStatus @default(PENDING)

  trainee     TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Restrict)
  sotApprover User?          @relation("PfySotSigner", fields: [sotApprovedById], references: [id], onDelete: Restrict)
  cosApprover User?          @relation("PfyCosSigner", fields: [cosApprovedById], references: [id], onDelete: Restrict)

  @@index([traineeId, academicYear])
}

// =============================================================================
// 10. TAMPER-EVIDENT APPEND-ONLY AUDIT LOG (H7)
// =============================================================================

model AuditLog {
  id         BigInt @id @default(autoincrement())
  entityType String // "TRAINEE", "LEDGER", "ROTATION", "ITA", "VOP"
  entityId   String
  action     String // "CREATE", "UPDATE", "REVOKE", "SIGN", "CONTEST"

  beforeJson Json?
  afterJson  Json?

  performedById String
  performedAt   DateTime @default(now())
  ipAddress     String?
  userAgent     String?

  // Cryptographic Hash Chaining (H7)
  prevHash String?
  rowHash  String // SHA-256 (prevHash + canonical row payload)

  performedByUser User @relation("AuditActor", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([performedById, performedAt])
  @@index([performedAt])
}

// =============================================================================
// 11. STAKEHOLDER EXTENSIONS: BULK INGESTION, EXIT DOSSIER, DOCUMENTS, ECHO (S1-S4)
// =============================================================================

// S1: Administrative Bulk CSV Ingestion Engine
model BulkIngestionBatch {
  id                String              @id @default(uuid())
  batchType         BulkIngestionType
  status            BulkIngestionStatus @default(PENDING_VALIDATION)
  fileName          String
  totalRows         Int                 @default(0)
  successRows       Int                 @default(0)
  errorRows         Int                 @default(0)
  dryRunSummaryJson Json?
  errorLogJson      Json?
  executedById      String
  executedAt        DateTime            @default(now())
  committedAt       DateTime?

  // Relations
  executedByUser User @relation("BulkBatchExecutor", fields: [executedById], references: [id], onDelete: Restrict)

  @@index([batchType, status])
  @@index([executedById, executedAt])
}

// S2: One-Click Fellowship Exit Dossier & Portfolio Compiler
model FellowshipExitDossier {
  id           String            @id @default(uuid())
  traineeId    String
  status       ExitDossierStatus @default(DRAFT)
  version      Int               @default(1)
  academicYear String

  // Automated Snapshot Aggregations
  executiveSummaryJson     Json
  accreditedMonthsSnapshot Decimal   @db.Decimal(5, 2)
  vopAuditSnapshotJson     Json
  msfSummaryJson           Json
  itaLadderJson            Json
  courseCertificatesJson   Json
  formalProjectApproved    Boolean   @default(false)
  formalProjectSignedAt    DateTime?
  examRecordsJson          Json

  // Cryptographic Verification Hash (S2)
  verificationHash    String
  qrVerificationToken String @unique @default(uuid())

  // Review & Approval Workflow
  submittedAt   DateTime?
  reviewedById  String?
  reviewedAt    DateTime?
  boeApprovedAt DateTime?
  boeComments   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  deletedBy String?

  // Relations
  trainee        TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Restrict)
  reviewedByUser User?          @relation("ExitDossierReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([traineeId, status])
  @@index([qrVerificationToken])
}

// S3: Trainee Document Lifecycle & Versioning
model DocumentRecord {
  id            String           @id @default(uuid())
  traineeId     String
  category      DocumentCategory
  status        DocumentStatus   @default(DRAFT)
  title         String
  fileName      String
  fileUrl       String
  fileSizeBytes Int?
  mimeType      String?
  fileHash      String?
  version       Int              @default(1)

  reviewerFeedback String?
  verifiedById     String?
  verifiedAt       DateTime?

  uploadedAt DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  deletedAt  DateTime?
  deletedBy  String?

  // Relations
  trainee        TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Restrict)
  verifiedByUser User?          @relation("DocumentVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@index([traineeId, category, status])
  @@index([status])
}

// Mandatory Courses (EASE, EMAC, ADAM-A, ECHO-A, USRA-E)
model MandatoryCourse {
  id             String             @id @default(uuid())
  traineeId      String
  courseCode     String
  courseName     String
  completionDate DateTime           @db.Date
  status         VerificationStatus @default(PENDING)
  documentId     String?

  verifiedById String?
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Relations
  trainee        TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Restrict)
  verifiedByUser User?          @relation("CourseVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@unique([traineeId, courseCode])
  @@index([traineeId, status])
}

// S4: Unified Echocardiography Logbook & DOPS
model EchoStudy {
  id        String        @id @default(uuid())
  traineeId String
  studyDate DateTime      @db.Date
  echoType  EchoStudyType @default(TTE)

  maskedHospitalNumber String?
  indication           String
  viewsObtainedJson    Json
  findingsSummary      String

  isDops          Boolean   @default(false)
  dopsRating      Int?
  dopsFeedback    String?
  supervisorId    String?
  supervisorToken String?   @unique
  tokenExpiresAt  DateTime?

  status     VerificationStatus @default(PENDING)
  verifiedAt DateTime?
  recordHash String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  deletedBy String?

  // Relations
  trainee    TraineeProfile @relation(fields: [traineeId], references: [id], onDelete: Restrict)
  supervisor User?          @relation("EchoSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)

  @@index([traineeId, studyDate])
  @@index([supervisorId, status])
  @@index([supervisorToken])
}
