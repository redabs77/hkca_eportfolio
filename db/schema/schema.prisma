  recognitionId String?
  cases         Int
  moduleCode    String? // descriptor the Board allocated the cases to; null counts to the overall total only
  reason        LedgerReason
  decisionDate  DateTime      @db.Date
  decidedByBody DecisionBody?
  note          String?
  recordedById  String?
  supersedesId  String?
  isCurrent     Boolean       @default(true)
  createdAt     DateTime      @default(now())

  trainee      TraineeProfile            @relation("CreditTrainee", fields: [traineeId], references: [id], onDelete: Restrict)
  recognition  RetrospectiveRecognition? @relation("CreditRecognition", fields: [recognitionId], references: [id], onDelete: Restrict)
  recordedBy   User?                     @relation("CreditRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  supersedes   VopCreditAdjustment?      @relation("CreditSupersedes", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy VopCreditAdjustment[]     @relation("CreditSupersedes")

  @@index([traineeId, isCurrent])
}

model VopVerificationEvent {
  id         String   @id @default(uuid())
  vopId      String
  fromStatus String?
  toStatus   String
  actorName  String?
  actorRole  String?
  note       String?
  occurredAt DateTime
  source     String // app | legacy_import

  vop VolumeOfPractice @relation("VopEventVop", fields: [vopId], references: [id], onDelete: Restrict)

  @@index([vopId, occurredAt])
}

model FormalProjectEvent {
  id           String   @id @default(uuid())
  projectId    String
  eventType    String // trainee-visible: protocol_submitted | revision_requested | protocol_resubmitted | protocol_approved | manuscript_* | accepted_paper_recorded. Internal: reviewers_assigned | reminder_sent | handed_to_team | late_report_accepted | reviewer_reassigned | appeal_received | certification_advice_queued
  eventDate    DateTime @db.Date
  versionNo    Int?
  outcomeNote  String? // trainee-visible; never names a blinded reviewer
  recordedById String?
  source       String // app | admin | legacy_backfill
  visibility   String   @default("trainee") // trainee | internal. Reminders, hand-over, override and reassignment are internal. A trainee-visible row never names a reviewer
  createdAt    DateTime @default(now())

  project    FormalProject @relation("ProjectEventProject", fields: [projectId], references: [id], onDelete: Restrict)
  recordedBy User?         @relation("ProjectEventRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([projectId, eventDate])
}

model FormalProjectReview {
  id                 String                @id @default(uuid())
  projectId          String
  stage              String // protocol | manuscript
  versionNo          Int                   @default(1)
  reviewerId         String
  assignedAt         DateTime
  assignedById       String?
  dueAt              DateTime              @db.Date // assignedAt + 2 months (HKCA-E03); a reminder goes 14 days before
  replacedAt         DateTime?
  replacedById       String?
  submittedAt        DateTime?
  recommendation     ReviewRecommendation?
  feedback           String?
  // Overdue handling (2026-10-25). After the deadline Admin may hand a missing review to the Formal Project Team;
  // the Team's review is recorded on the same row (byTeam). A late report is ignored unless Admin overrides with a reason.
  handedToTeamAt     DateTime?
  byTeam             Boolean               @default(false)
  lateOverrideReason String?
  lateOverrideById   String?
  reassignReason     String? // on the NEW row written by a reassignment
  reminderSentAt     DateTime?

  project        FormalProject @relation("ReviewProject", fields: [projectId], references: [id], onDelete: Restrict)
  reviewer       User          @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  assignedBy     User?         @relation("ReviewAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  replacedBy     User?         @relation("ReviewReplacer", fields: [replacedById], references: [id], onDelete: Restrict)
  lateOverrideBy User?         @relation("ReviewLateOverrider", fields: [lateOverrideById], references: [id], onDelete: Restrict)

  @@index([projectId, stage])
  @@index([reviewerId])
}

model LearningPlan {
  id                String    @id @default(uuid())
  traineeId         String
  planType          String // SIX_MONTH | PF_YEAR
  periodStart       DateTime  @db.Date
  periodEnd         DateTime  @db.Date
  assignedSotId     String?
  status            String    @default("NOT_SET") // NOT_SET, DRAFT, SUBMITTED, CHANGES_REQUESTED, AWAITING_COS, SIGNED, CHANGE_PROPOSED, CHANGE_COS, REVIEW_OPEN, REVIEW_SUBMITTED, REVIEWED
  version           Int       @default(0)
  notifiedAt        DateTime? @db.Date
  submittedAt       DateTime? @db.Date
  signedById        String?
  signedAt          DateTime? @db.Date
  cosApprovedById   String?
  cosApprovedAt     DateTime? @db.Date
  reviewSummary     String?
  reviewSubmittedAt DateTime? @db.Date
  reviewedById      String?
  reviewedAt        DateTime? @db.Date
  reviewComment     String?

  trainee       TraineeProfile         @relation("PlanTrainee", fields: [traineeId], references: [id], onDelete: Cascade)
  assignedSot   User?                  @relation("PlanAssignedSot", fields: [assignedSotId], references: [id], onDelete: Restrict)
  signedBy      User?                  @relation("PlanSigner", fields: [signedById], references: [id], onDelete: Restrict)
  cosApprovedBy User?                  @relation("PlanCos", fields: [cosApprovedById], references: [id], onDelete: Restrict)
  reviewedBy    User?                  @relation("PlanReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  goals         LearningGoal[]         @relation("GoalPlan")
  proposals     LearningPlanProposal[] @relation("ProposalPlan")

  @@unique([traineeId, planType, periodStart])
}

model LearningGoal {
  id                String    @id @default(uuid())
  planId            String
  planVersion       Int
  domainCode        String // CF-2.x | SM-3.x | ITA-* | OTHER | CLINICAL | MANAGEMENT | EDUCATION
  objective         String
  success           String
  evidence          String?
  reflection        String?
  outcome           String? // COMPLETELY_ACHIEVED | PARTIALLY_ACHIEVED | NOT_ACHIEVED (advisory, graded by Assigned SOT at synthesis)
  outcomeGradedById String?
  outcomeGradedAt   DateTime?
  outcomeItaId      String?

  plan            LearningPlan @relation("GoalPlan", fields: [planId], references: [id], onDelete: Cascade)
  outcomeGradedBy User?        @relation("GoalGrader", fields: [outcomeGradedById], references: [id], onDelete: Restrict)
  outcomeIta      ItaSession?  @relation("GoalIta", fields: [outcomeItaId], references: [id], onDelete: Restrict)

  @@index([planId, planVersion])
}

model LearningPlanProposal {
  id                String    @id @default(uuid())
  planId            String
  reason            String
  proposedGoalsJson Json
  proposedAt        DateTime? @db.Date
  sotDecidedById    String?
  sotDecidedAt      DateTime? @db.Date
  sotDecision       String?
  cosDecidedById    String?
  cosDecidedAt      DateTime? @db.Date
  cosDecision       String?
  boardInformedAt   DateTime? @db.Date

  plan         LearningPlan @relation("ProposalPlan", fields: [planId], references: [id], onDelete: Cascade)
  sotDecidedBy User?        @relation("ProposalSot", fields: [sotDecidedById], references: [id], onDelete: Restrict)
  cosDecidedBy User?        @relation("ProposalCos", fields: [cosDecidedById], references: [id], onDelete: Restrict)
}

model SotAssignment {
