model LogbookVerifierAssignment {
  id               String    @id @default(uuid())
  traineeId        String
  verifierId       String? // null = unassigned pool: any ASOT/SOT at the trainee hospital may claim
  assignedAt       DateTime?
  assignedById     String?
  unassignedAt     DateTime?
  unassignedReason String?
  isCurrent        Boolean   @default(true)

  trainee    TraineeProfile @relation("VerifierTrainee", fields: [traineeId], references: [id], onDelete: Cascade)
  verifier   User?          @relation("VerifierUser", fields: [verifierId], references: [id], onDelete: Restrict)
  assignedBy User?          @relation("VerifierAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

