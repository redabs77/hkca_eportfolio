  applicationId String
  signerRole    ApplicationSignerRole
  signerUserId  String?
  method        SigningMethod?
  requestedAt   DateTime              @default(now())
  signedAt      DateTime?
  documentId    String? // signed PDF when method = PDF
  attachedById  String? // Admin who attached the PDF

  application Application @relation("EndorsementApplication", fields: [applicationId], references: [id], onDelete: Cascade)
  signer      User?       @relation("EndorsementSigner", fields: [signerUserId], references: [id], onDelete: Restrict)
  attachedBy  User?       @relation("EndorsementAttacher", fields: [attachedById], references: [id], onDelete: Restrict)

  @@unique([applicationId, signerRole])
}

model RetrospectiveRecognitionEvent {
  id            String             @id @default(uuid())
  recognitionId String
  eventType     String // requested | enabled | submitted | documents_returned | sent_to_training_officer | more_documents_asked | decided | referred_to_board | credit_executed
  fromStatus    RecognitionStatus?
  toStatus      RecognitionStatus?
  actorUserId   String?
  actorRole     String // ADMIN | TRAINING_OFFICER | BOARD
  onBehalf      Boolean            @default(false) // Admin recorded an outcome that arrived outside the system
  outcome       String?
  note          String?
  eventDate     DateTime           @db.Date
  createdAt     DateTime           @default(now())

  recognition RetrospectiveRecognition @relation("RecognitionEventRecognition", fields: [recognitionId], references: [id], onDelete: Restrict)
  actor       User?                    @relation("RecognitionEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([recognitionId, eventDate])
}
