  traineeId    String
  examType     String   @default("INTERMEDIATE")
  kind         String // ANZCA_PRIMARY | FRCA_PRIMARY | OTHER_BOARD
  grantedOn    DateTime @db.Date
  reference    String?
  note         String?
  recordedById String?
  createdAt    DateTime @default(now())

  trainee    TraineeProfile @relation("ExemptionTrainee", fields: [traineeId], references: [id], onDelete: Restrict)
  recordedBy User?          @relation("ExemptionRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([traineeId, examType])
}

model FormalProjectStage {
  id           String                @id @default(uuid())
  projectId    String
  stage        String // protocol | manuscript
  state        ProjectStageState     @default(AWAITING_REVIEWERS)
  roundNo      Int                   @default(1) // a revision starts a new round with the same reviewers
  dispatchedAt DateTime?             @db.Date
  dueAt        DateTime?             @db.Date // dispatched + two months
  decision     ReviewRecommendation?
  decidedOn    DateTime?             @db.Date
  appealedOn   DateTime? // one appeal only; a rejection after appeal is final
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @default(now()) @updatedAt

  project FormalProject @relation("StageProject", fields: [projectId], references: [id], onDelete: Restrict)

