  @@index([createdAt])
}

model CourseCatalogue {
  courseCode  String  @id // EASE, EMAC, ADAM-A, ECHO-A, UGRA, plus non-mandatory legacy courses
  courseName  String
  isMandatory Boolean @default(false)
  organiser   String? // CSC (Clinical Simulation Committee) | HKCA

  rounds CourseRound[] @relation("RoundCourse")
}

model CourseRound {
  id                   String    @id @default(uuid())
  courseCode           String
  roundDate            DateTime  @db.Date
  seats                Int? // null = no cap (e.g. the Mock Viva)
  status               String    @default("open") // stored: open | cancelled. Not-open-yet, open, closed, held and recorded are DERIVED from the dates, registrationShutAt and attendanceRecordedAt
  attendanceRecordedAt DateTime?
  endDate              DateTime? @db.Date
  venue                String?
  format               String? // Face-to-face | Online | Online and face-to-face
  feeMember            Int? // HK$; null = fee to be confirmed, 0 = no charge
  feeNonMember         Int?
  registrationOpens    DateTime? @db.Date
  registrationCloses   DateTime? @db.Date
  registrationShutAt   DateTime? // Admin closed registration early (Close now); reopening clears it and sets a new closing date
  coordinators         String?
  rankingMode          String    @default("priority") // priority | fcfs (first come first served; anyone waitlisted last time still goes first)

  catalogue   CourseCatalogue    @relation("RoundCourse", fields: [courseCode], references: [courseCode], onDelete: Restrict)
  completions MandatoryCourse[]  @relation("CourseRoundCompletion")
  requests    CourseRequest[]    @relation("RequestRound")
  attendance  CourseAttendance[] @relation("AttendanceRound")
  notices     CourseNotice[]     @relation("NoticeRound")

  @@index([courseCode, roundDate])
}

model CourseRequest {
  id          String         @id @default(uuid())
  roundId     String
  traineeId   String
  requestedAt DateTime
  decision    CourseDecision @default(REQUESTED)
  decidedById String?
  decidedAt   DateTime?
  withdrawnAt DateTime? // trainee withdrew before the deadline; excluded from applicant counts

  round     CourseRound    @relation("RequestRound", fields: [roundId], references: [id], onDelete: Restrict)
  trainee   TraineeProfile @relation("RequestTrainee", fields: [traineeId], references: [id], onDelete: Restrict)
  decidedBy User?          @relation("RequestDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([roundId, traineeId])
  @@index([traineeId])
}

model RosterRound {
  id       String   @id @default(uuid())
  period   String   @unique // January and July rounds, e.g. 2026-07, 2027-01
  opensOn  DateTime @db.Date
  closesOn DateTime @db.Date

  attestations RosterAttestation[] @relation("AttestRound")
}

model RosterAttestation {
  id            String    @id @default(uuid())
  roundId       String
  hospitalId    String
  confirmedById String?
  confirmedAt   DateTime?
  changesJson   Json? // trainer list changes: joined, left, moved to another hospital
  reviewedById  String?
  reviewedAt    DateTime?

  round       RosterRound @relation("AttestRound", fields: [roundId], references: [id], onDelete: Restrict)
  hospital    Hospital    @relation("AttestHospital", fields: [hospitalId], references: [id], onDelete: Restrict)
  confirmedBy User?       @relation("AttestConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  reviewedBy  User?       @relation("AttestReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@unique([roundId, hospitalId])
}

// =============================================================================
// 13. SECRETARIAT CONSOLE: COURSES, EXAMS, FORMAL PROJECTS, RECOGNITION (migration 5, 2026-10-25)
// =============================================================================

model CourseAttendance {
  id                String   @id @default(uuid())
  roundId           String
  traineeId         String
  ratePercent       Int // 0 to 100. 70 or more earns the Certificate of Attendance; below 50 is reported (HKCA courses only)
  certificateIssued Boolean  @default(false)
  recordedAt        DateTime @default(now())
  recordedById      String?
  sourceBatchId     String?

  round       CourseRound         @relation("AttendanceRound", fields: [roundId], references: [id], onDelete: Restrict)
  trainee     TraineeProfile      @relation("AttendanceTrainee", fields: [traineeId], references: [id], onDelete: Restrict)
  recordedBy  User?               @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  sourceBatch BulkIngestionBatch? @relation("AttendanceBatch", fields: [sourceBatchId], references: [id], onDelete: SetNull)

  @@unique([roundId, traineeId])
  @@index([traineeId])
}

model CourseNotice {
  id          String    @id @default(uuid())
  roundId     String
  traineeId   String
  ratePercent Int
  noticeType  String    @default("UNDER_50_REPORT") // UNDER_50_REPORT (HKCA courses: Chief of Service and SOT) | UNDER_100_CSC (CSC courses: the SOT)
  queuedAt    DateTime  @default(now())
  sentAt      DateTime?

  round   CourseRound    @relation("NoticeRound", fields: [roundId], references: [id], onDelete: Restrict)
  trainee TraineeProfile @relation("NoticeTrainee", fields: [traineeId], references: [id], onDelete: Restrict)

  @@unique([roundId, traineeId, noticeType])
}

model ExamSitting {
  id        String    @id @default(uuid())
  examType  String // INTERMEDIATE | FINAL_ANAESTHESIA | FINAL_ICU
  name      String // for example "Feb / Apr 2027"
  opensOn   DateTime  @db.Date
  closesOn  DateTime  @db.Date // 3 to 8 weeks before the first written paper (Vocational Training Guide 2.4.2); checked in the write
  mcqOn     DateTime? @db.Date
  writtenOn DateTime  @db.Date
  oralOn    DateTime? @db.Date
  oralEndOn DateTime? @db.Date
  osceOn    DateTime? @db.Date
  feeHkd    Int
  shutAt    DateTime? // Admin closed applications early
  createdAt DateTime  @default(now())

  applications  ExamApplication[] @relation("ApplicationSitting")
  results       ExamResult[]      @relation("ResultSitting")
  sectionPasses ExamSectionPass[] @relation("PassSitting")

  @@index([examType, writtenOn])
}

model ExamResult {
  id            String   @id @default(uuid())
  traineeId     String
  examType      String // INTERMEDIATE | FINAL_ANAESTHESIA | FINAL_ICU
  sittingId     String?
  applicationId String?
  examDate      DateTime @db.Date
  attemptNumber Int      @default(1)
  result        String // PASS | FAIL (overall)
  score         Decimal? @db.Decimal(5, 2)
  // Intermediate, per subject. A blank subject is carried forward from an earlier sitting.
  physiology    String? // PASS | FAIL
  pharmacology  String? // PASS | FAIL
  minimumMet    Boolean? // needed when one subject is passed and the other failed: the pass carries forward only if the minimum score was met in the failed subject
  // Final, per section. oral and OSCE are one result (decided 2026-10-25).
  written       String? // PASS | FAIL; blank = carried forward
  oralOsce      String? // PASS | FAIL
  sourceBatchId String?
  createdAt     DateTime @default(now())

  trainee     TraineeProfile      @relation("ResultTrainee", fields: [traineeId], references: [id], onDelete: Restrict)
  sitting     ExamSitting?        @relation("ResultSitting", fields: [sittingId], references: [id], onDelete: Restrict)
  application ExamApplication?    @relation("ResultApplication", fields: [applicationId], references: [id], onDelete: SetNull)
  sourceBatch BulkIngestionBatch? @relation("ResultBatch", fields: [sourceBatchId], references: [id], onDelete: SetNull)

  @@unique([traineeId, examType, attemptNumber])
  @@index([traineeId, examType])
}

model ExamSectionPass {
  id              String   @id @default(uuid())
  traineeId       String
  examType        String // INTERMEDIATE | FINAL_ANAESTHESIA
  section         String // PHYSIOLOGY | PHARMACOLOGY | WRITTEN
  passedOn        DateTime @db.Date
  passedSittingId String?
  sittingsLeft    Int      @default(4) // carried forward for up to four subsequent consecutive exams. Counting every sitting is OUR reading; confirm with the College
  isActive        Boolean  @default(true) // false once used up or when the exam is passed. One active carried pass per trainee and exam (partial unique index in the migration)
  createdAt       DateTime @default(now())

  trainee       TraineeProfile @relation("PassTrainee", fields: [traineeId], references: [id], onDelete: Restrict)
  passedSitting ExamSitting?   @relation("PassSitting", fields: [passedSittingId], references: [id], onDelete: Restrict)

  @@index([traineeId, examType, isActive])
}

model TraineeFeePayment {
  id           String    @id @default(uuid())
  traineeId    String
  feeType      String // REGISTRATION | TRAINING
  paidOn       DateTime  @db.Date
  reference    String?
  recordedById String?
  voidedAt     DateTime? // a wrongly recorded payment is voided, never deleted
  createdAt    DateTime  @default(now())

  trainee    TraineeProfile @relation("FeeTrainee", fields: [traineeId], references: [id], onDelete: Restrict)
  recordedBy User?          @relation("FeeRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([traineeId, feeType])
}

model TraineeExemption {
