  sot            User           @relation("SotAsgSot", fields: [sotId], references: [id], onDelete: Restrict)
  reassignedFrom User?          @relation("SotAsgFrom", fields: [reassignedFromId], references: [id], onDelete: Restrict)
  reassignedBy   User?          @relation("SotAsgBy", fields: [reassignedById], references: [id], onDelete: Restrict)

