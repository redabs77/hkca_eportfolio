{
  "name": "hkca-eporfolio",
  "version": "1.0.0",
  "description": "Replacement for the legacy HKCA Electronic Training Portfolio (ETP/EPS) — a role-aware web application tracking anaesthesia trainees from Basic Anaesthesia Training (BAT) through Higher Anaesthesia Training (HAT) and Provisional Fellowship Year (PFY) to Fellowship.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "npm run test:parity",
    "postinstall": "prisma generate --schema db/schema/schema.prisma || exit 0",
    "test:parity": "node tests/parity/verify_parity.mjs",
    "prisma:generate": "prisma generate --schema db/schema/schema.prisma",
    "prisma:format": "prisma format --schema db/schema/schema.prisma",
    "seed": "node scripts/test_seed.mjs",
    "test:domain": "node tests/domain/run_domain_tests.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redabs77/hkca_eportfolio.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/redabs77/hkca_eportfolio/issues"
  },
  "homepage": "https://github.com/redabs77/hkca_eportfolio#readme",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.30",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^6.19.3",
    "@types/pg": "^8.23.1",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  }
}
